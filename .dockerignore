# Git
.git
.gitignore
.gitattributes

# Editor
**/.vscode
**/.idea
**/.DS_Store
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

# Environment files (never bake secrets into image)
**/.env
**/.env.*
!**/.env.example

# Frontend — not needed for backend Docker build
frontend/node_modules
frontend/dist
frontend/.next
frontend/build

# Backend dev dependencies and caches
backend/vendor
backend/node_modules
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/.phpunit.cache
backend/coverage

# Docker files themselves
docker/
Dockerfile.all-in-one
fly.toml

# Docs
*.md
DEPLOYMENT_GUIDE.md
PRODUCTION_CHECKLIST.md

# Misc
misc
