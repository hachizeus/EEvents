# API URLs — in production both should point to your public API domain
VITE_API_URL_CLIENT=https://your-domain.com/api
VITE_API_URL_SERVER=http://backend:80/api

VITE_FRONTEND_URL=https://your-domain.com

# Paystack public key (use pk_test_... for development, pk_live_... for production)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
