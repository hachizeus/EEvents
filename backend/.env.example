APP_NAME="E Events"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_LOG_QUERIES=false
APP_URL=http://localhost
APP_PORT=8080
APP_FRONTEND_URL=https://localhost:8443
APP_CDN_URL=http://localhost:9000/eevents-public
APP_SAAS_MODE_ENABLED=false
APP_HOMEPAGE_VIEWS_UPDATE_BATCH_SIZE=8
APP_DISABLE_REGISTRATION=false
APP_PLATFORM_SUPPORT_EMAIL=support@your-domain.com
APP_ALLOWED_INTERNAL_WEBHOOK_HOSTS=

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eevents
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_PUBLIC_DISK=s3-public
FILESYSTEM_PRIVATE_DISK=s3-private
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="E Events"

AWS_ACCESS_KEY_ID=your_aws_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_PUBLIC_BUCKET=your-public-bucket
AWS_PRIVATE_BUCKET=your-private-bucket
# Remove AWS_ENDPOINT and AWS_USE_PATH_STYLE_ENDPOINT in production (those are for local MinIO only)
# AWS_ENDPOINT=http://minio:9000
# AWS_USE_PATH_STYLE_ENDPOINT=true

JWT_SECRET=
JWT_ALGO=HS256

# Required for SAAS mode if charging platform fees
# OPEN_EXCHANGE_RATES_APP_ID=

# Paystack Payment Gateway
# Use test keys for local development, live keys for production
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here
